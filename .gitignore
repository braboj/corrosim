# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Coverage (pytest-cov)
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual envs
.venv/
venv/
env/

# Tool / run outputs
*.html
# the curated multiscale report bundle is tracked, per case study
# (cases/<case>/report/report.html + report.docx + figures/ + tables/; see
# runs/make_report.py)
!cases/*/report/report.html
# report render goldens are tracked test fixtures (tests/test_report_golden.py)
!tests/goldens/*.html
*.cif
*.cube
*_slab.xyz
results.csv
!examples/*.csv

# zip exports of a case bundle are a redundant artifact (the report/ tree is
# already tracked); keep the multi-MB archive out of git
cases/**/*.zip

# QC scratch dirs
orca_*/
g16_*/
*.gbw
*.chk
*.log

# OS / editor
.DS_Store
.idea/
~$*.docx        # Word lock/owner files

# VSCode: share the project setup (mypy/ruff/Pylance wiring), ignore the rest
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code per-user settings (shared .claude/settings.json stays trackable)
.claude/settings.local.json

# Local-only notes (kept with the project, never pushed)
*.local.md
docs/local/

# loose run-output figures in repo root (cases/<case>/report/figures/ holds the
# curated set)
/*.png

# Volumetric cubes: large, regenerable (make_cubes) — never tracked
cubes/

# Detached job logs: local monitoring scratch, never tracked
logs/

# Generated Pages gallery: built in CI (make_pages) from the tracked reports
_site/
