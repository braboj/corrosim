# Keep the build context small + fast. The Dockerfile copies only what it needs.
.git
.venv
venv
env
# private notes + ~150 MB of PDFs — never send to the daemon
docs/local/
# regenerable volumetric cubes and per-case output trees: the Dockerfile copies
# only pyproject.toml, README.md, THIRD_PARTY_NOTICES.md and src/, so these only
# bloat the build context
cubes/
cases/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
*.html
*.cif
*_slab.xyz
results.csv
orca_*/
g16_*/
*.local.md
.idea/
.vscode/
